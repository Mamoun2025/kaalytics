{
  "redirects": [
    { "source": "/checklist-maintenance", "destination": "/guides/checklist-maintenance", "permanent": true },
    { "source": "/comparatif-fleet-management", "destination": "/guides/comparatif-fleet-management", "permanent": true },
    { "source": "/guide-flotte-btp", "destination": "/guides/guide-flotte-btp", "permanent": true },
    { "source": "/ai-engine", "destination": "/modules/ai-engine", "permanent": true },
    { "source": "/digital-platform", "destination": "/modules/digital-platform", "permanent": true },
    { "source": "/erp-connect", "destination": "/modules/erp-connect", "permanent": true },
    { "source": "/financial-operations", "destination": "/modules/financial-operations", "permanent": true },
    { "source": "/fleetops", "destination": "/modules/fleetops", "permanent": true },
    { "source": "/marketing-automation", "destination": "/modules/marketing-automation", "permanent": true },
    { "source": "/sales-intelligence", "destination": "/modules/sales-intelligence", "permanent": true },
    { "source": "/supply-chain", "destination": "/modules/supply-chain", "permanent": true },
    { "source": "/btp", "destination": "/industries/btp", "permanent": true },
    { "source": "/distribution", "destination": "/industries/distribution", "permanent": true },
    { "source": "/industrie", "destination": "/industries/industrie", "permanent": true },
    { "source": "/location", "destination": "/industries/location", "permanent": true },
    { "source": "/mines", "destination": "/industries/mines", "permanent": true },
    { "source": "/transport", "destination": "/industries/transport", "permanent": true },
    { "source": "/locamat", "destination": "/case-studies/locamat", "permanent": true },
    { "source": "/terrafleet", "destination": "/case-studies/terrafleet", "permanent": true },
    { "source": "/transmaroc", "destination": "/case-studies/transmaroc", "permanent": true },
    { "source": "/privacy", "destination": "/legal/privacy", "permanent": true },
    { "source": "/terms", "destination": "/legal/terms", "permanent": true },
    { "source": "/mentions", "destination": "/legal/mentions", "permanent": true },
    { "source": "/cookies", "destination": "/legal/cookies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/locales/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
